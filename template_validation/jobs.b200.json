{
  "jobs": [
    {
      "name": "fa4-kernel",
      "gpus": [
        0
      ],
      "timeout_seconds": 600,
      "argv": [
        "{python}",
        "{project_dir}/template_validation/tests/ml/fa4_gpu_probe.py",
        "{run_dir}/fa4-kernel.json"
      ],
      "required_outputs": [
        {
          "path": "fa4-kernel.json",
          "json_equals": {
            "status": "passed"
          }
        }
      ]
    },
    {
      "name": "sdpa-1gpu",
      "gpus": [
        0
      ],
      "timeout_seconds": 1800,
      "argv": [
        "{python}",
        "{project_dir}/template_validation/tests/ml/gpu_workflow_probe.py",
        "--output",
        "{run_dir}/sdpa-1gpu",
        "--backend",
        "sdpa",
        "--world-size",
        "1"
      ],
      "required_outputs": [
        {
          "path": "sdpa-1gpu/complete.json",
          "json_equals": {
            "status": "passed",
            "world_size": 1,
            "backend": "sdpa"
          }
        }
      ]
    },
    {
      "name": "sdpa-2gpu",
      "gpus": [
        0,
        1
      ],
      "timeout_seconds": 1800,
      "argv": [
        "{python}",
        "{project_dir}/template_validation/tests/ml/gpu_workflow_probe.py",
        "--output",
        "{run_dir}/sdpa-2gpu",
        "--backend",
        "sdpa",
        "--world-size",
        "2"
      ],
      "required_outputs": [
        {
          "path": "sdpa-2gpu/complete.json",
          "json_equals": {
            "status": "passed",
            "world_size": 2,
            "backend": "sdpa"
          }
        }
      ]
    },
    {
      "name": "fa4-1gpu",
      "gpus": [
        0
      ],
      "timeout_seconds": 1800,
