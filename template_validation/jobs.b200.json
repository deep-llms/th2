        "{project_dir}/template_validation/tests/ml/gpu_workflow_probe.py",
        "--output",
        "{run_dir}/fa4-1gpu",
        "--backend",
        "fa4",
        "--world-size",
        "1"
      ],
      "required_outputs": [
        {
          "path": "fa4-1gpu/complete.json",
          "json_equals": {
            "status": "passed",
            "world_size": 1,
            "backend": "fa4"
          }
        }
      ]
    },
