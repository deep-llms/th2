{
  "jobs": [
    {
      "name": "resume_verification",
      "argv": [
        "{python}", "tests/bdot/resume_gpu_probe.py", "suite",
        "--output", "{run_dir}/checks",
        "--accelerate-config", "{project_dir}/resources/accelerate_b200.yaml"
      ],
      "gpus": [0, 1, 2, 3, 4, 5, 6, 7],
      "timeout_seconds": 1800,
      "required_outputs": [
        {"path": "checks/summary.json", "json_equals": {"status": "passed"}}
      ]
    }
  ]
}
